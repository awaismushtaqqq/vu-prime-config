# ─────────────────────────────────────────────────────────────
# VU Prime payments — environment variables
# Vercel → Project → Settings → Environment Variables mein add karein.
# Yeh file sirf example hai; asli values kabhi git mein commit na karein.
# ─────────────────────────────────────────────────────────────

# Site ka apna URL (return/callback URLs isi se bante hain)
SITE_URL=https://your-domain.com

# ── GitHub (activation config.json mein likhne ke liye) ──
# Fine-grained personal access token, sirf isi repo par "Contents: Read and write".
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxx
GH_OWNER=awaismushtaqqq
GH_REPO=vu-prime-config
GH_BRANCH=main
GH_CONFIG_PATH=config.json
GH_ORDERS_PATH=processed-orders.json

# ── Kaunsa gateway use karna hai: jazzcash | safepay ──
PAYMENT_PROVIDER=jazzcash

# ── JazzCash (merchant account se milte hain) ──
JAZZCASH_MERCHANT_ID=MC12345
JAZZCASH_PASSWORD=xxxxxxxx
JAZZCASH_INTEGRITY_SALT=xxxxxxxx
# Testing ke liye false rakhein (sandbox), live jane par true
JAZZCASH_LIVE=false

# ── Safepay (agar PAYMENT_PROVIDER=safepay) ──
SAFEPAY_API_KEY=sec_xxxxxxxx
SAFEPAY_WEBHOOK_SECRET=xxxxxxxx
SAFEPAY_LIVE=false
# Zaroorat par hi set karein (default sandbox/production URLs code mein hain)
# SAFEPAY_API_BASE=
# SAFEPAY_CHECKOUT_BASE=

# ── Qeematein (PKR) — chahein to badal lein ──
PLAN_MONTHLY_PRICE=1000
PLAN_YEARLY_PRICE=8000
PLAN_LIFETIME_PRICE=20000
PLAN_MONTHLY_DAYS=30
PLAN_YEARLY_DAYS=365
CURRENCY=PKR

# ── Manual bank transfer (optional — jo bhi set karenge wahi site par dikhega) ──
BANK_NAME=Meezan Bank
BANK_ACCOUNT_TITLE=Awais Mushtaq
BANK_ACCOUNT_NUMBER=01234567890123
BANK_IBAN=PK00MEZN0001234567890123
EASYPAISA_NUMBER=03460306869
JAZZCASH_NUMBER=03460306869
SUPPORT_WHATSAPP=+92 346 0306869

# ── Admin panel (/admin.html) ka token — lamba random string rakhein ──
ADMIN_TOKEN=change-me-to-a-long-random-string
